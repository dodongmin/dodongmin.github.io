---
import Button from "../ui/Button.astro";
import Heading from "../ui/Heading.astro";
import Tools from "../portfolio/Tools.astro";
import { Icon } from "astro-icon/components";
import Hobbies from "../portfolio/Hobbies.astro";
import { getCollection } from "astro:content";

// ⬇ 대표 프로젝트 3개(PostgreSQL11 HA, Monitoring, Infra)
import { getFeaturedProjects } from "../portfolio/data/projects";

const [staticData] = await getCollection("staticData");
const {
  profileAlt,
  profileLink,
  profileImage,
  profileName,
  profileTitle,
  email,
  emailIconName,
  github,
  portfolioImage,
  contactSectionButtonText,
} = staticData.data;

// i18n을 쓰면 lang 넘겨줘도 됩니다.
const featured = getFeaturedProjects(undefined);
---

<section
  class="scroll-m-16 px-8 max-sm:px-4 py-8"
  id="home"
  aria-label="Professional profile and introduction"
>
  <!-- ===== Hero / Profile ===== -->
  <div
    class="mx-auto mb-4 h-96 w-full max-w-7xl rounded-2xl bg-linear-to-r from-gray-200 dark:from-zinc-700 to-white dark:to-zinc-900 hover:to-gray-300/30 dark:hover:to-zinc-700/30 p-[.2rem] max-md:h-auto"
  >
    <div
      class="group relative z-0 flex h-full items-center justify-center gap-8 overflow-hidden rounded-2xl bg-linear-to-tr from-gray-100 to-white p-4 transition-all hover:shadow-[0_10px_50px_rgba(0,0,0,0.2)] dark:bg-linear-to-r dark:from-black dark:to-zinc-950 dark:overflow-hidden max-md:w-full max-md:gap-3 max-lg:gap-2 max-sm:flex-col before:bg-[radial-gradient(circle,rgba(0,0,0,0.12)_0,rgba(0,0,0,0)_100%)] before:absolute before:left-65 before:top-10 before:h-[40%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-80 before:-z-10 before:transition hover:before:animate-pulse"
    >
      <div class="aspect-square h-4/5 max-md:size-32">
        <div
          class="group-hover:scale-105 relative z-10 flex w-full cursor-pointer items-center overflow-hidden rounded-full p-[2px] transition-all duration-500"
        >
          <div class="absolute inset-0 h-full w-full rounded-full from-transparent to-gray-500 dark:from-transparent dark:to-gray-300 animate-rotate-border bg-conic/[from_var(--border-angle)]"></div>
          <div class="relative z-20 flex w-full rounded-full bg-zinc-900">
            <div
              class="w-full aspect-square rounded-full bg-center bg-cover"
              style={`background-image: url(${profileImage})`}
              aria-label={profileAlt}
            >
              <a
                href={profileLink}
                class="flex h-full w-full"
                aria-label="소개 페이지로 이동"></a>
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex h-full w-7/12 flex-col justify-center gap-4 p-4 max-md:w-full max-md:gap-2"
      >
        <span
          class="relative inline-flex items-center text-xs font-semibold leading-0 dark:text-white text-blacktext max-md:font-medium max-sm:justify-center"
        >
          <span
            class="before:mr-2 before:block before:h-1.5 before:w-1.5 before:rounded-full before:bg-green-400 before:shadow-[0px_0px_0px_3px_rgba(34,197,94,0.5)] before:animate-pulse before:content-['']"
          ></span>
          현재 재직 중 | 협업 가능
        </span>

        <h1
          class="text-4xl font-black leading-none text-blacktext dark:text-white max-xl:text-3xl max-lg:text-2xl max-sm:text-center"
        >
          👋
        </h1>
        <p
          class="mb-0 text-lg font-semibold leading-8 text-blacktext dark:text-gray-200 max-xl:text-base"
        >
          <span class="bg-linear-to-r from-gray-600 to-black bg-clip-text font-black text-transparent dark:from-gray-300 dark:to-white">{profileTitle}</span>
          입니다. PostgreSQL HA/VIP 장애조치, Prometheus·Grafana 모니터링, Docker 표준 운영,
          RAG 에이전트 구축까지
          <span
            class="bg-linear-to-r from-riptide-500 to-mint-500 bg-clip-text font-black text-transparent dark:from-riptide-300 dark:to-mint-200"
            > 백엔드·DevOps 전 영역을 A부터 Z까지</span
          >
          진행합니다.
        </p>

        <div class="hidden"></div>
      </div>
    </div>
  </div>

  <!-- ===== Home Cards (취미 / 깃허브 / Tech 카드 / Projects 카드 링크) ===== -->
  <div
    class="mx-auto grid max-w-7xl grid-cols-2 grid-rows-4 max-sm:gap-3 gap-4 md:grid-cols-4 md:grid-rows-2 mb-0"
  >
    

    <!-- Tech 카드 -->
    <div class="col-span-2 col-start-1 row-start-1 rounded-2xl bg-linear-to-r from-gray-200 dark:from-zinc-700 to-white dark:to-zinc-900 p-[.2rem] md:col-start-3">
      <article
        class="group relative z-0 flex h-full w-full flex-col overflow-hidden rounded-2xl bg-linear-to-tr from-gray-100 to-white p-6 transition hover:shadow-[0_10px_50px_rgba(0,0,0,0.2)] dark:bg-linear-to-r dark:from-black dark:to-zinc-950 dark:overflow-hidden max-md:p-4 gap-6 max-md:gap-3 max-lg:gap-4 before:bg-[radial-gradient(circle,rgba(0,0,0,0.1)_0,rgba(0,0,0,0)_100%)] before:absolute before:left-30 before:-bottom-0 before:h-[80%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-30 before:-z-10 before:transition"
      >
        <div class="flex items-center gap-4 max-md:gap-2">
          <Icon class="text-3xl dark:text-white text-gray-700 max-md:text-2xl max-sm:text-sm" name="dashboard" aria-hidden="true" />
          <Heading text="Tech Stack" textGradient="" level={3} />
        </div>
        <div class="overflow-y-auto">
          <Tools />
        </div>
      </article>
    </div>

    <!-- Projects 카드(상단 링크 카드) -->
    <div class="col-span-2 col-start-1 row-start-1 rounded-2xl bg-linear-to-r from-gray-200 dark:from-zinc-700 to-white dark:to-zinc-900 p-[.2rem] md:col-start-1">
      <article
        class="group relative z-0 flex h-full w-full flex-col overflow-hidden rounded-2xl bg-linear-to-tr from-gray-100 to-white p-6 transition hover:shadow-[0_10px_50px_rgba(0,0,0,0.2)] dark:bg-linear-to-r dark:from-black dark:to-zinc-950 dark:overflow-hidden max-md:p-4 gap-6 max-md:gap-3 max-lg:gap-4 before:bg-[radial-gradient(circle,rgba(0,0,0,0.1)_0,rgba(0,0,0,0)_100%)] before:absolute before:left-30 before:-bottom-0 before:h-[80%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-30 before:-z-10 before:transition"
      >
        <a
          href="#projects"
          class="absolute left-0 top-0 z-40 h-full w-full bg-transparent"
          aria-label="프로젝트 섹션으로 이동"></a>
        <div class="flex items-center gap-4 max-md:gap-2">
          <Icon class="text-3xl dark:text-white text-gray-700 max-md:text-2xl max-sm:text-sm" name="code" aria-hidden="true" />
          <Heading text="Projects" textGradient="" level={3} />
        </div>
        <div class="overflow-y-auto">
          <p class="z-2 text-lg font-semibold leading-6 dark:text-gray-200 text-blacktext max-xl:text-base">
            Project
            <span class="bg-linear-to-r from-gray-600 to-black bg-clip-text font-black text-transparent dark:from-gray-300 dark:to-white">Completed</span>
          </p>
        </div>
      </article>
    </div>
  </div>
</section>


